# ---------------------------------------------------------------------------
# Database (Neon Postgres)
# Pooled connection for the app, direct connection for migrations.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/productcart?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/productcart?sslmode=require"

# ---------------------------------------------------------------------------
# Auth.js (NextAuth v5)
# Generate a secret with: npx auth secret  (or: openssl rand -base64 32)
# ---------------------------------------------------------------------------
AUTH_SECRET="replace-with-a-long-random-string"

# OAuth providers
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
